{
    "extends": "./../tsconfig.json",
    "compilerOptions": {
        "paths": {
            "@/*": ["../src/*"]
        },
        "types": ["@types/jest", "@types/node"],
        "composite": true,
        "rootDir": "../",
        "module": "es2022",
        "target": "esnext",
        "esModuleInterop": true
    },
    "include": [
        "./../src",
        "./../test"
    ],
    "exclude": [
        "./../dist"
    ]
}
