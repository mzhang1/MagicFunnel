{
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"],
            "@images/*": ["./src/resources/media/images/*"]
        },
        "module": "es6",
        "target": "es6",
        "sourceMap": true,
        "declaration": true,
        "declarationMap": true,
        "strict": true,
        "jsx": "react-jsx",
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        "noUncheckedSideEffectImports": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "lib": ["dom", "esnext"],
        "moduleResolution": "bundler"
    },
    "references": [
        { "path": "./src/tsconfig.app.json" },
        { "path": "./test/tsconfig.test.json" }
    ]
}
